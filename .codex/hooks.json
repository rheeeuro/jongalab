{
  "description": "Generated from .agent-config; do not edit this file directly.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agent-config/sync.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Claude/Codex 설정 동기화"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/edit_hook.py\" guard",
            "timeout": 30,
            "statusMessage": "민감 파일 변경 여부 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/edit_hook.py\" post",
            "timeout": 300,
            "statusMessage": "변경 파일 품질 검사"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agent-config/sync.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Claude/Codex 설정 동기화"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$(git rev-parse --show-toplevel)/.codex/hooks/deploy-on-stop.sh\"",
            "timeout": 600,
            "statusMessage": "변경된 서비스 빌드 및 반영"
          }
        ]
      }
    ]
  }
}
